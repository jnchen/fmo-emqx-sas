FMO_IMAGE=ghcr.io/your-org/fmo-emqx-sas:latest

# 只对外暴露两个端口：MQTT 和一个统一 Web 端口。
# 容器内部：MQTT 1883、FAS 9527、EMQX Dashboard 18083、SAS 8080、nginx 8081。
# WEB_PORT 只是宿主机映射；容器内 nginx 固定监听 8081（WEB_LISTEN_PORT）。
MQTT_PORT=18831
WEB_PORT=18080

# 统一 Web 端口用 Cookie 切换，不需要域名：
#   打开 http://<IP>:<WEB_PORT>/__fmo 选择 FAS 或 EMQX
#   或直接收藏 http://<IP>:<WEB_PORT>/__fmo/fas
#              http://<IP>:<WEB_PORT>/__fmo/emqx
# 选择结果写入 fmoapp Cookie，之后所有请求自动路由到对应应用。
# 访问 / 时如果还没有 Cookie，进入 WEB_DEFAULT 指定的应用。
WEB_DEFAULT=fas

# 设 0 可关闭 nginx；此时需要自己把 9527/18083 发布出来。
WEB_ENABLED=1

# 以下四项必须对应这一套 FMO 服务器。
SAS_SERVER_UID=10032
SAS_SERVER_CALLSIGN=B0ABC
SAS_MQTT_HOST=fmo.example.com
# 必须是设备实际连接的对外端口（通常等于 MQTT_PORT），不是容器内的 1883。
SAS_MQTT_PORT=18831
SAS_CERT_FINGERPRINT=replace-with-fmo-certificate-fingerprint

EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=replace-with-a-long-password

# 审计服务默认启动；设 0 可只跑 SAS + EMQX。
FAS_ENABLED=1

# 可选：声明式集群节点。留空表示不覆盖 config.json 里已有的 Mqtt.Clusters。
# 每项字段与 SAS 的 mqtt.clusters 一致；mqtt_host/mqtt_port 必须是设备可访问的公网地址。
# SAS_CLUSTERS_JSON='[{"uid":10033,"callsign":"B0DEF","mqtt_host":"fmo-b.example.com","mqtt_port":43911,"certFingerprint":"..."}]'
SAS_CLUSTERS_JSON=

# 可选：声明式管理员列表（会整体替换 Server.Admins）。
# 注意：列表非空时，服务器自身不会自动获得 super，除非也在这里列出。
# SAS_ADMINS_JSON='[{"uid":10032,"certFingerprint":"...","role":"super"}]'
SAS_ADMINS_JSON=
